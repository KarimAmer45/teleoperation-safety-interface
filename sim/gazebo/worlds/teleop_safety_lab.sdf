<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="teleop_safety_lab">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="key_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0.4 0.2 0</pose>
      <diffuse>0.9 0.9 0.86 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>12 8 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12 8 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.78 1</ambient>
            <diffuse>0.78 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="human_proxy">
      <static>true</static>
      <pose>1.7 0.9 0.9 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.32 0.64 1</ambient>
            <diffuse>0.18 0.32 0.64 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_left">
      <static>true</static>
      <pose>-2.7 1.8 0.65 0 0 0</pose>
      <link name="rack">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.45 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.45 1.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.44 0.39 0.31 1</ambient>
            <diffuse>0.44 0.39 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_right">
      <static>true</static>
      <pose>2.8 -1.6 0.65 0 0 0</pose>
      <link name="rack">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.7 0.45 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 0.45 1.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.47 0.42 1</ambient>
            <diffuse>0.42 0.47 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="safety_bot">
      <pose>0 0 0.18 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>16</mass>
          <inertia>
            <ixx>0.42</ixx>
            <iyy>0.58</iyy>
            <izz>0.72</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.7 0.48 0.22</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.7 0.48 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.24 0.25 1</ambient>
            <diffuse>0.06 0.24 0.25 1</diffuse>
          </material>
        </visual>
        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.34 0 0.18 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>15</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.5708</min_angle>
                <max_angle>1.5708</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>8</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.29 -0.04 1.5708 0 0</pose>
        <inertial>
          <mass>1.4</mass>
          <inertia>
            <ixx>0.01</ixx>
            <iyy>0.01</iyy>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.11</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.11</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.29 -0.04 1.5708 0 0</pose>
        <inertial>
          <mass>1.4</mass>
          <inertia>
            <ixx>0.01</ixx>
            <iyy>0.01</iyy>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.11</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.11</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.58</wheel_separation>
        <wheel_radius>0.11</wheel_radius>
        <topic>/model/safety_bot/cmd_vel</topic>
        <odom_topic>/model/safety_bot/odometry</odom_topic>
        <tf_topic>/model/safety_bot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    </model>
  </world>
</sdf>
