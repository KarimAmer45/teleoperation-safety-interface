<?xml version="1.0"?>
<package format="3">
  <name>tsi_bridge</name>
  <version>0.1.0</version>
  <description>Telemetry bridge for the Teleoperation Safety Interface Gazebo simulation.</description>
  <maintainer email="maintainer@example.com">Teleoperation Safety Interface contributors</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
